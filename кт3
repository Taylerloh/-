<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Мои карточки</title>
<style>
/* Шрифты и основной фон */
body {
background-color: #e0f7fa; /* Светло-голубой фон */
font-family: 'Arial', sans-serif; /* Современный шрифт */
padding: 20px;
}
/* Стили для заголовков */
h1, h2 {
font-family: 'Verdana', sans-serif; /* Шрифт для заголовков */
text-align: center;
color: #00796b; /* Темно-зеленый цвет заголовков */
}
/* Общий контейнер для секций */
.container {
max-width: 1000px;
margin: 0 auto;
}
/* Секция с карточками */
.section {
background-color: #ffffff;
padding: 25px;
border-radius: 10px;
margin-bottom: 30px;
box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Тень для секции */
}
/* FLEXBOX контейнер */
.flex-container {
display: flex;
justify-content: center;
flex-wrap: wrap;
gap: 20px;
}
/* GRID контейнер */
.grid-container {
display: grid;
grid-template-columns: repeat(5, 1fr);
gap: 20px;
}
/* Общий стиль для всех карточек */
.card {
width: 150px;
height: 150px;
border-radius: 10px;
color: white;
/* Центрирование текста по вертикали и горизонтали */
display: flex;
justify-content: center;
align-items: center;
text-align: center;
padding: 10px;
font-weight: bold; /* Жирный текст для карточек */
}
/* Разные цвета для карточек */
.card1 { background-color: #ff5722; } /* Оранжевый */
.card2 { background-color: #4caf50; } /* Зеленый */
.card3 { background-color: #2196f3; } /* Синий */
.card4 { background-color: #ffeb3b; } /* Желтый */
.card5 { background-color: #9c27b0; } /* Фиолетовый */
.card6 { background-color: #009688; } /* Бирюзовый */
.card7 { background-color: #3f51b5; } /* Индиго */
.card8 { background-color: #795548; } /* Коричневый */
.card9 { background-color: #607d8b; } /* Серый */
.card10 { background-color: #f44336; } /* Красный */
</style>
</head>
<body>
<div class="container">
<h1>Карточки на Flexbox и Grid</h1>
<!-- Секция с Flexbox -->
<div class="section">
<h2>Flexbox</h2>
<div class="flex-container">
<div class="card card1">CARD 1</div>
<div class="card card2">CARD 2</div>
<div class="card card3">CARD 3</div>
<div class="card card4">CARD 4</div>
<div class="card card5">CARD 5</div>
</div>
</div>
<!-- Секция с Grid -->
<div class="section">
<h2>Grid</h2>
<div class="grid-container">
<div class="card card6">CARD 6</div>
<div class="card card7">CARD 7</div>
<div class="card card8">CARD 8</div>
<div class="card card9">CARD 9</div>
<div class="card card10">CARD 10</div>
</div>
</div>
</div>
</body>
</html>
